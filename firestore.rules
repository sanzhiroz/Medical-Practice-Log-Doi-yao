rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Test connection probe
    match /test/connection {
      allow read: if true;
    }

    // Node Doi Yao Medical Practice Logs
    match /practice_logs/{logId} {
      allow read: if true;
      allow create: if request.resource.data.doctorName is string
                    && request.resource.data.date is string
                    && request.resource.data.healthCenter is string
                    && request.resource.data.timeShift is string;
      allow update: if request.resource.data.doctorName is string
                    && request.resource.data.date is string
                    && request.resource.data.healthCenter is string;
      allow delete: if true;
    }
  }
}
